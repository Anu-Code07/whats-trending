generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentDepth {
  quick
  normal
  deep
}

enum NotificationFrequency {
  critical
  relevant
  daily
  digest
  off
}

enum ImpactLevel {
  low
  medium
  high
  critical
}

enum StoryStatus {
  active
  evolving
  archived
}

enum ArticleContentType {
  official
  journalism
  community
  analysis
}

enum SourceType {
  rss
  api
  scraper
}

enum EntityType {
  company
  technology
  topic
}

enum InteractionType {
  opened
  completed
  saved
  shared
  ignored
}

enum SaveCollection {
  read_later
  learn
  career
  build_ideas
  interesting
}

enum TimelineType {
  breaking
  updated
  reaction
  analysis
}

enum TrendDirection {
  rising
  stable
  falling
}

enum NotificationType {
  critical
  relevant
  brief
  digest
}

enum InterestSource {
  onboarding
  explicit
  inferred
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  displayName           String?
  careerMode            Boolean               @default(false)
  role                  String?
  contentDepth          ContentDepth          @default(normal)
  notificationFrequency NotificationFrequency @default(relevant)
  lastActiveAt          DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  interests     UserInterest[]
  interactions  UserInteraction[]
  savedStories  SavedStory[]
  notifications Notification[]
  dailyBriefs   DailyBrief[]
}

model Story {
  id              String      @id @default(uuid())
  slug            String      @unique
  title           String
  summary         String
  whyItMatters    String
  whoShouldCare   String[]
  impact          ImpactLevel @default(medium)
  category        String
  sourceCount     Int         @default(1)
  importanceScore Float       @default(0.5)
  trendMomentum   Float?
  isBreaking      Boolean     @default(false)
  publishedAt     DateTime
  updatedAt       DateTime    @updatedAt
  status          StoryStatus @default(active)

  articles     Article[]
  timeline     StoryTimeline[]
  interactions UserInteraction[]
  savedBy      SavedStory[]
  entities     StoryEntity[]
}

model Article {
  id          String             @id @default(uuid())
  storyId     String?
  sourceId    String
  externalId  String?
  url         String             @unique
  title       String
  body        String?
  author      String?
  publishedAt DateTime
  contentType ArticleContentType @default(journalism)
  urlHash     String

  story    Story?          @relation(fields: [storyId], references: [id])
  source   Source          @relation(fields: [sourceId], references: [id])
  timeline StoryTimeline[]
}

model Source {
  id           String     @id @default(uuid())
  name         String
  url          String
  type         SourceType @default(rss)
  qualityScore Float      @default(0.5)
  logoUrl      String?

  articles Article[]
}

model Entity {
  id          String     @id @default(uuid())
  type        EntityType
  name        String
  slug        String     @unique
  description String?
  logoUrl     String?
  metadata    Json?

  stories StoryEntity[]
}

model StoryEntity {
  storyId  String
  entityId String
  story    Story  @relation(fields: [storyId], references: [id])
  entity   Entity @relation(fields: [entityId], references: [id])

  @@id([storyId, entityId])
}

model Interest {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  parentId String?
  icon     String?

  parent   Interest?      @relation("InterestTree", fields: [parentId], references: [id])
  children Interest[]     @relation("InterestTree")
  users    UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  affinity   Float          @default(0.5)
  isFollowed Boolean        @default(false)
  isMuted    Boolean        @default(false)
  source     InterestSource @default(onboarding)

  user     User     @relation(fields: [userId], references: [id])
  interest Interest @relation(fields: [interestId], references: [id])

  @@id([userId, interestId])
}

model UserInteraction {
  id         String          @id @default(uuid())
  userId     String
  storyId    String
  type       InteractionType
  durationMs Int?
  createdAt  DateTime        @default(now())

  user  User  @relation(fields: [userId], references: [id])
  story Story @relation(fields: [storyId], references: [id])
}

model SavedStory {
  userId    String
  storyId   String
  collection SaveCollection @default(read_later)
  savedAt   DateTime       @default(now())

  user  User  @relation(fields: [userId], references: [id])
  story Story @relation(fields: [storyId], references: [id])

  @@id([userId, storyId])
}

model StoryTimeline {
  id         String       @id @default(uuid())
  storyId    String
  type       TimelineType
  title      String
  articleId  String?
  occurredAt DateTime

  story   Story    @relation(fields: [storyId], references: [id])
  article Article? @relation(fields: [articleId], references: [id])
}

model Trend {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  direction    TrendDirection @default(stable)
  volumeChange Float?
  description  String?
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  storyId String?
  type    NotificationType
  title   String
  body    String
  sentAt  DateTime?
  readAt  DateTime?

  user User @relation(fields: [userId], references: [id])
}

model DailyBrief {
  id             String   @id @default(uuid())
  userId         String
  date           DateTime @db.Date
  topStories     String[]
  missedStories  String[]
  generatedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}
